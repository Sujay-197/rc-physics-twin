build/
build-*/
out/
cmake-build-*/
*.o
*.obj
*.so
*.dll
*.dylib
*.pyd

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
dist/

# unity
unity/**/Library/
unity/**/Temp/
unity/**/Obj/
unity/**/Logs/
unity/**/UserSettings/
unity/**/*.csproj
unity/**/*.sln

# run outputs (keep small reference runs under results/reference/)
results/*
!results/reference/
*.mcap
wandb/

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# local native toolchain (tools/bootstrap_toolchain.py)
.toolchain/

# .NET build outputs (native/tests/csharp)
bin/
obj/

# Unity: plugin is a build output (cmake --target unity_plugin); IDE solution
unity/**/Assets/Plugins/
unity/**/Assets/Plugins.meta
unity/**/*.slnx

# map screenshots used as references (third-party imagery: not redistributed)
campus/reference/
# campus scenery from local map screenshots (tools/campus_scenery.py)
unity/**/Generated/Campus/Local/
unity/**/Generated/Campus/Local.meta

# trained models (tens of MB): kept local; their metadata, learning curves and the released exports are committed
policies/study/*.zip
policies/study/*.pkl
policies/v2/*.zip
policies/v2/*.pkl
policies/twin-car/*.zip
policies/twin-car/*.pkl
